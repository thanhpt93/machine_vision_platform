{
  "name": "machine-vision-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Industrial Machine Vision Desktop Platform on Windows",
  "main": "dist/main/main.js",
  "scripts": {
    "dev:renderer": "vite",
    "build:main": "tsc -p tsconfig.node.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "electron .",
    "dev": "concurrently -k \"vite\" \"wait-on tcp:127.0.0.1:5173 && npm run build:main && cross-env NODE_ENV=development electron .\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "py:install": "pip install -r python_runtime/requirements.txt",
    "py:start": "python -m uvicorn vision_runtime.main:app --app-dir python_runtime --host 127.0.0.1 --port 8000 --reload",
    "py:test": "pytest python_runtime/tests"
  },
  "dependencies": {
    "@xyflow/react": "^12.4.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.0.7",
    "wait-on": "^8.0.2"
  }
}
